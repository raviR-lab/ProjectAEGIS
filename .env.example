# Neo4j
NEO4J_PASSWORD=changeme
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# Ollama / local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=LFM2.5:Q4

# GitHub via MCP only (token is injected into the MCP server process)
# auto | mcp | fixture
GITHUB_SOURCE=auto
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
# Optional CIG PR → GitHub PR map (demo: 482→#1, 500→#2)
GITHUB_PR_MAP=482:1,500:2

# Jira via MCP only (no in-app REST)
# mcp | cloud (alias of mcp) | local
JIRA_SOURCE=local
JIRA_BASE_URL=https://YOUR_SITE.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=AEG
JIRA_PROJECT_NAME=Project AEGIS

# MCP stdio servers (spawned with npx). Editable on Infrastructure & CIG.
# Versions pinned to reduce supply-chain risk.
MCP_GITHUB_COMMAND=npx
MCP_GITHUB_PACKAGE=@modelcontextprotocol/server-github@2025.4.8
MCP_GITHUB_ARGS=
MCP_JIRA_COMMAND=npx
MCP_JIRA_PACKAGE=@aashari/mcp-server-atlassian-jira@3.3.0
MCP_JIRA_ARGS=

# Jenkins via MCP only (no in-app REST)
# auto | mcp | off
JENKINS_SOURCE=auto
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=
MCP_JENKINS_COMMAND=npx
MCP_JENKINS_PACKAGE=@kud/mcp-jenkins@2.2.0
MCP_JENKINS_ARGS=

# Microsoft Teams via MCP (interactive OAuth login; read-only by default)
# read-only | read-write
TEAMS_SOURCE=auto
TEAMS_MCP_READ_ONLY=true
MCP_TEAMS_COMMAND=npx
MCP_TEAMS_PACKAGE=@floriscornel/teams-mcp@0.9.0
MCP_TEAMS_ARGS=
# One-time auth from the server host:
#   npx @floriscornel/teams-mcp authenticate

# Security: JSONL audit trail for every MCP tool call (default /tmp/aegis-mcp-audit.jsonl)
AEGIS_AUDIT_LOG=

JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=
